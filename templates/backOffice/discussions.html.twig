{% extends 'base_back.html.twig' %}

{% block title %}discussions {% endblock %}

        
 {% block content %}

  
    
            <div class="page-header" style="display: inline-block; margin: 5px; padding: 10px; width: 100%;">
                <h1 class="my-4" style="display: inline-block; white-space: nowrap; width: auto; margin: 10px; padding: 10px 15px; font-size: 26px;" >Liste des Discussions</h1>
            </div>
        <a href="{{ path('app_discussion_new') }}" 
           class="btn btn-primary mb-3"
           style="display: inline-block; white-space: nowrap; width: auto; margin: 5px; padding: 5px 15px; font-size: 16px;">
            Créer Une Nouvelle Discussion
        </a>
            <div  style="margin-right: 35px; padding: 20px; ">
           
                

                <table class="table table-bordered" style="margin-top: 15px;">
                    <thead class="thead-dark">
                        <tr >
                            <th style="margin: 20px; padding: 20px;">ID</th>
                            <th style="margin: 20px; padding: 20px;">Adresse</th>
                            <th style="margin: 20px; padding: 20px;">Sujet</th>
                            <th style="margin: 20px; padding: 20px;">Destinataire</th>
                            <th style="margin: 20px; padding: 20px;">Contenu</th>
                            <th style="margin: 20px; padding: 20px;">Professeur</th>
                            <th style="margin: 20px; padding: 20px;">Rôle</th>
                            <th style="margin: 20px; padding: 20px;">Élève</th>
                            <th style="margin: 20px; padding: 20px;">Actions</th>
                        </tr>
                    </thead>
                    <tbody  >
                    {% for discussion in discussions %}
                        <tr>
                            <td style="margin: 2px; padding: 20px;">{{ discussion.id }}</td>
                            <td style="margin: 2px; padding: 20px;">{{ discussion.adresse }}</td>
                            <td style="margin: 2px; padding: 20px;">{{ discussion.sujet }}</td>
                            <td style="margin: 2px; padding: 20px;">{{ discussion.destinataire }}</td>
                            <td style="margin: 2px; padding: 20px;">{{ discussion.contenu }}</td>
                            <td style="margin: 2px; padding: 20px;">{{ discussion.professeur }}</td>
                            <td style="margin: 2px; padding: 20px;">{{ discussion.role }}</td>
                            <td style="margin: 2px; padding: 20px;">{{ discussion.eleve }}</td>
                            <td>
                                <a href="{{ path('app_discussion_show', {'id': discussion.id}) }}" class="btn btn-info btn-sm" style="margin: 2px">Voir</a>
                                <a href="{{ path('app_discussion_edit', {'id': discussion.id}) }}" class="btn btn-warning btn-sm" style="margin: 2px">Modifier</a>
                                <form method="post" action="{{ path('app_discussion_delete', {'id': discussion.id}) }}" style="display:inline; margin: 2px">
                                    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ discussion.id) }}">
                                    <button type="submit" class="btn btn-danger btn-sm" style="margin-right: 1px;" onclick="return confirm('Are you sure?');">Supprimer</button>
                                </form>
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="9" class="text-center" style="padding: 20px; font-size: 16px;">Aucune discussion trouvée.</td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>

    </div>

           
    

{% endblock %}
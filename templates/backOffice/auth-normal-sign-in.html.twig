{% extends 'base_back.html.twig' %}

{% block title %}Sign In{% endblock %}

{% block navbar %}{% endblock %}
{% block sidebar %}{% endblock %}
{% block welc %}{% endblock %}
{% block preloader %}{% endblock %}
{% block main %}{% endblock %}

{% block content %}
    <section class="login p-fixed d-flex text-center bg-primary common-img-bg" style='    justify-content: center;
'>
        <div class="container">
            <div class="row">
                <div class="col-sm-12">
                    <div class="login-card card-block auth-body mr-auto ml-auto">
                        {% for label, messages in app.flashes %}
                            {% for message in messages %}
                                <div class="alert alert-{{ label }}">
                                    {{ message }}
                                </div>
                            {% endfor %}
                        {% endfor %}

                        <form class="md-float-material" method="post" action="{{ path('login') }}">
                            <div class="text-center">
                                <img src="{{ asset('back/images/auth/logo-dark.png') }}" alt="logo.png">
                            </div>
                            <div class="auth-box">
                                <div class="row m-b-20">
                                    <div class="col-md-12">
                                        <h3 class="text-left txt-primary">Sign In</h3>
                                    </div>
                                </div>
                                <hr/>
                                <div class="input-group">
                                    <input type="email" name="_username" class="form-control" placeholder="Your Email Address" required>
                                    <span class="md-line"></span>
                                </div>
                                <div class="input-group">
                                    <input type="password" name="_password" class="form-control" placeholder="Password" required>
                                    <span class="md-line"></span>
                                </div>
                                <div class="row m-t-30">
                                    <div class="col-md-12">
                                        <button type="submit" class="btn btn-primary btn-md btn-block waves-effect text-center m-b-20">Sign in</button>
                                    </div>
                                    <div class="col-md-12">
                                        <a href="{{ path('app_signin') }}" class="btn btn-primary btn-md btn-block waves-effect text-center m-b-20">Sign up</a>
                                    </div>
                                </div>
                                <hr/>
                                <div class="row">
                                    <div class="col-md-10">
                                        <p class="text-inverse text-left m-b-0">Thank you.</p>
                                        <p class="text-inverse text-left"><b>Your Authentication Team</b></p>
                                    </div>
                                    <div class="col-md-2">
                                        <img src="{{ asset('back/images/auth/Logo-small-bottom.png') }}" alt="small-logo.png">
                                    </div>
                                </div>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </section>
{% endblock %}

{% block css %}
    <link rel="stylesheet" type="text/css" href="{{ asset('back/css/style.css') }}">
    <style>
        .alert {
            margin: 10px;
            padding: 10px;
            border-radius: 4px;
        }
        .alert-error {
            background-color: #f8d7da;
            border-color: #f5c6cb;
            color: #721c24;
        }
        .alert-success {
            background-color: #d4edda;
            border-color: #c3e6cb;
            color: #155724;
        }
    </style>
{% endblock %}
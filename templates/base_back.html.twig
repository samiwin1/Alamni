<!DOCTYPE html>
<html lang="en">
	<head>
		<title>
			{% block title %}Admin Dashboard
			{% endblock %}
		</title>
		<meta charset="utf-8">
		<meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=0, minimal-ui">
		<meta http-equiv="X-UA-Compatible" content="IE=edge">
		<meta name="description" content="CodedThemes">
		<meta name="keywords" content="Admin, Dashboard">
		<meta name="author" content="CodedThemes">

		{% block css %}
			<!-- Google Fonts -->
			<link href="https://fonts.googleapis.com/css?family=Open+Sans:400,600" rel="stylesheet">
			<link
			rel="icon" href="{{ asset('back/images/favicon.ico') }}" type="image/x-icon">
			<!-- Icon Font Stylesheet -->
			<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.10.0/css/all.min.css">
			<link
			rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.4.1/font/bootstrap-icons.css">
			<!-- Libraries Stylesheet -->
			<link rel="stylesheet" href="{{ asset('back/lib/animate/animate.min.css') }}">
			<link
			rel="stylesheet" href="{{ asset('back/lib/owlcarousel/assets/owl.carousel.min.css') }}">
			<!-- Customized Bootstrap Stylesheet -->
			<link
			rel="stylesheet" href="{{ asset('back/css/bootstrap.min.css') }}">
			<!-- Template Stylesheet -->
			<link rel="stylesheet" href="{{ asset('back/css/style.css') }}">
			<style>
				.img-radius {
					border-radius: 50%;
					object-fit: cover;
				}
				.label {
					padding: 4px 8px;
					border-radius: 3px;
					font-size: 12px;
					font-weight: 600;
					color: white;
				}
				.label-danger {
					background-color: #ff5252;
				}
				.label-success {
					background-color: #4CAF50;
				}
				.label-info {
					background-color: #2196F3;
				}
				.table td {
					vertical-align: middle;
				}
				.btn-group .btn {
					padding: 5px 10px;
					margin: 0 2px;
				}
				.card {
					margin-bottom: 30px;
					border: none;
					border-radius: 5px;
					box-shadow: 0 0 20px rgba(0, 0, 0, 0.08);
				}
				.card-header {
					background-color: #fff;
					border-bottom: 1px solid #f1f1f1;
					padding: 20px;
					position: relative;
				}
				.card-header-right {
					position: absolute;
					right: 20px;
					top: 15px;
				}
			</style>
		{% endblock %}
	</head>

	<body>
		{% for label, messages in app.flashes %}
			{% for message in messages %}
				<div class="alert alert-{{ label }} alert-dismissible fade show" role="alert">
					{{ message }}
					<button type="button" class="close" data-dismiss="alert" aria-label="Close">
						<span aria-hidden="true">&times;</span>
					</button>
				</div>
			{% endfor %}
		{% endfor %}

		{% if app.session.get('user_email') or app.request.get('_route') in ['login', 'app_signin'] %}
			{% block content %}
				<!-- Navbar -->
				{% block navbar %}
					<div id="pcoded" class="pcoded">
						<div class="pcoded-overlay-box"></div>
						<div class="pcoded-container navbar-wrapper">
							<nav class="navbar header-navbar pcoded-header">
								<div class="navbar-wrapper">
									<div class="navbar-logo">
										<a class="mobile-menu" id="mobile-collapse" href="#!">
											<i class="ti-menu"></i>
										</a>
										<a href="{{ path('admin_dashboard') }}">
											<img class="img-fluid" src="{{ asset('back/images/logo.png') }}" alt="Theme-Logo"/>
										</a>
										<a class="mobile-options">
											<i class="ti-more"></i>
										</a>
									</div>
									<div class="navbar-container container-fluid">
										<ul class="nav-right">
											{% if app.session.get('user_email') %}
												<li class="user-profile header-notification">
													<a href="#!">
														<img src="{% if user.photo %}data:image/jpeg;base64,{{ user.photo }}{% else %}{{ asset('back/images/avatar-4.jpg') }}{% endif %}" class="img-radius" alt="User-Profile-Image">
														<span>{{ user.nom }}
															{{ user.prenom }}</span>
														<i class="ti-angle-down"></i>
													</a>
													<ul class="show-notification profile-notification">
														<li>
															<a href="{{ path('user_profile') }}">
																<i class="ti-user"></i>
																Profile
															</a>
														</li>
														<li>
															<a href="{{ path('logout') }}">
																<i class="ti-layout-sidebar-left"></i>
																Logout
															</a>
														</li>
													</ul>
												</li>
											{% endif %}
										</ul>
									</div>
								</div>
							</nav>
						</div>
					</div>
				{% endblock %}

				{% block main %}
					<div class="pcoded-main-container">
						<div
							class="pcoded-wrapper">
							<!-- Sidebar -->
							{% block sidebar %}
								{% if app.session.get('user_email') %}
									<nav class="pcoded-navbar">
										<div class="sidebar_toggle">
											<a href="#">
												<i class="icon-close icons"></i>
											</a>
										</div>
										<div class="pcoded-inner-navbar main-menu">
											<div class="main-menu-header">
												<img class="img-40 img-radius" src="{% if user.photo %}data:image/jpeg;base64,{{ user.photo }}{% else %}{{ asset('back/images/avatar-4.jpg') }}{% endif %}" alt="User-Profile-Image">
												<div class="user-details">
													<span>{{ user.nom }}
														{{ user.prenom }}</span>
													<span id="more-details">{{ user.role }}<i class="ti-angle-down"></i>
													</span>
												</div>
											</div>
											<ul class="pcoded-item pcoded-left-item">
												<li class="active">
													<a href="{{ path('admin_dashboard') }}">
														<span class="pcoded-micon">
															<i class="ti-home"></i>
														</span>
														<span class="pcoded-mtext">Dashboard</span>
													</a>
												</li>
												{% if user.role == 'ROLE_ADMIN' %}
													<li>
														<a href="{{ path('admin_dashboard') }}">
															<span class="pcoded-micon">
																<i class="ti-user"></i>
															</span>
															<span class="pcoded-mtext">Gestion Utilisateurs</span>
														</a>
													</li>
												{% endif %}
											</ul>
										</div>
									</nav>
								{% endif %}
							{% endblock %}

							<div class="pcoded-content">
								<div class="pcoded-inner-content">
									<div class="main-body">
										<div class="page-wrapper">
											{% block welc %}
												{% if app.session.get('user_email') %}
													<div class="page-body">
														{% if user.role == 'ROLE_ADMIN' %}
															<div class="card">
																<div class="card-header" style="
    margin-top: 100px;
">
																	<h5>Liste des Utilisateurs</h5>
																	<div class="card-header-right">
																		<a href="{{ path('app_signin') }}" class="btn btn-primary">
																			<i class="ti-plus"></i>
																			Ajouter
																		</a>
																	</div>
																</div>
																<div class="card-block" style="
																																				    margin-left: 360px;
																																				    margin-top: 100px;
																																				">
																	<div class="table-responsive">
																		<table class="table table-hover">
																			<thead>
																				<tr>
																					<th>Photo</th>
																					<th>Nom</th>
																					<th>Prénom</th>
																					<th>Email</th>
																					<th>Rôle</th>
																					<th>Niveau</th>
																					<th>Actions</th>
																				</tr>
																			</thead>
																			<tbody>
																				{% if users is defined %}
																					{% for user in users %}
																						<tr>
																							<td>
																								<img src="{% if user.photo %}data:image/jpeg;base64,{{ user.photo }}{% else %}{{ asset('back/images/avatar-4.jpg') }}{% endif %}" class="img-radius" style="width: 40px; height: 40px;">
																							</td>
																							<td>{{ user.nom }}</td>
																							<td>{{ user.prenom }}</td>
																							<td>{{ user.email }}</td>
																							<td>
																								<span class="label {% if user.role == 'ROLE_ADMIN' %}label-danger{% elseif user.role == 'ROLE_ELEVE' %}label-success{% else %}label-info{% endif %}">
																									{{ user.role|replace({'ROLE_': ''}) }}
																								</span>
																							</td>
																							<td>
																								{% if user.role == 'ROLE_ELEVE' %}
																									{{ user.niveau }}
																									{{ user.nomNiveau }}
																								{% else %}
																									-
																								{% endif %}
																							</td>
																							<td>
																								<div class="btn-group">
																									<a href="{{ path('user_profile_edit', {'id': user.id}) }}" class="btn btn-info btn-sm">
																										modifier
																									</a>
																									<form method="post" action="{{ path('user_profile_delete', {'id': user.id}) }}" style="display: inline-block" onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer cet utilisateur ?');">
																										<input type="hidden" name="_token" value="{{ csrf_token('delete' ~ user.id) }}">
																										<button class="btn btn-danger btn-sm">
																											supprimer
																										</button>
																									</form>
																								</div>
																							</td>
																						</tr>
																					{% else %}
																						<tr>
																							<td colspan="7" class="text-center">
																								Aucun utilisateur trouvé
																							</td>
																						</tr>
																					{% endfor %}
																				{% endif %}
																			</tbody>
																		</table>
																	</div>
																</div>
															</div>
														{% else %}
															<h1>Welcome
																{{ user.nom }}
																{{ user.prenom }}</h1>
														{% endif %}
													</div>
												{% endif %}
											{% endblock %}
										</div>
									</div>
								</div>
							</div>
						</div>
					</div>
				{% endblock %}
			{% endblock %}
		{% else %}
			<div class="alert alert-warning text-center">
				<h4>Accès restreint</h4>
				<p>Veuillez vous
					<a href="{{ path('login') }}">connecter</a>
					pour accéder au dashboard.</p>
			</div>
		{% endif %}

		{% block js %}
			<script src="{{ asset('back/js/jquery/jquery.min.js') }}"></script>
			<script src="{{ asset('back/js/jquery-ui/jquery-ui.min.js') }}"></script>
			<script src="{{ asset('back/js/popper.js/popper.min.js') }}"></script>
			<script src="{{ asset('back/js/bootstrap/js/bootstrap.min.js') }}"></script>
			<script src="{{ asset('back/js/jquery-slimscroll/jquery.slimscroll.js') }}"></script>
			<script src="{{ asset('back/js/modernizr/modernizr.js') }}"></script>
			<script src="{{ asset('back/js/script.js') }}"></script>
			<script src="{{ asset('back/js/SmoothScroll.js') }}"></script>
			<script src="{{ asset('back/js/pcoded.min.js') }}"></script>
			<script src="{{ asset('back/js/demo-12.js') }}"></script>
			<script src="{{ asset('back/js/jquery.mCustomScrollbar.concat.min.js') }}"></script>
			<script>
				$(document).ready(function () { // Initialize tooltips
$('[data-toggle="tooltip"]').tooltip();

// Confirm delete
$('.btn-danger').click(function () {
return confirm('Êtes-vous sûr de vouloir effectuer cette action ?');
});
});
			</script>
		{% endblock %}
	</body>
</html>

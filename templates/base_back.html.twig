<!DOCTYPE html>
<html lang="en">
	<head>
		<title>
			{% block title %}Admin Dashboard
			{% endblock %}
		</title>

		<!-- Meta -->
		<meta charset="utf-8">
		<meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=0, minimal-ui">
		<meta http-equiv="X-UA-Compatible" content="IE=edge">
		<meta name="description" content="CodedThemes">
		<meta name="keywords" content="Admin, Responsive, Bootstrap, Dashboard, Template">
		<meta name="author" content="CodedThemes">

		{% block css %}
			<!-- Google Fonts -->
			<link href="https://fonts.googleapis.com/css?family=Open+Sans:400,600" rel="stylesheet">
			<link
			rel="icon" href="{{ asset('back/images/favicon.ico') }}" type="image/x-icon">

			<!-- Icon Font Stylesheet -->
			<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.10.0/css/all.min.css">
			<link
			rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.4.1/font/bootstrap-icons.css">

			<!-- Libraries Stylesheet -->
			<link rel="stylesheet" href="{{ asset('back/lib/animate/animate.min.css') }}">
			<link
			rel="stylesheet" href="{{ asset('back/lib/owlcarousel/assets/owl.carousel.min.css') }}">

			<!-- Customized Bootstrap Stylesheet -->
			<link
			rel="stylesheet" href="{{ asset('back/css/bootstrap.min.css') }}">

			<!-- Template Stylesheet -->
			<link rel="stylesheet" href="{{ asset('back/css/style.css') }}">
		{% endblock %}

	</head>

	<body>
		{% for label, messages in app.flashes %}
			{% for message in messages %}
				<div class="alert alert-{{ label }} alert-dismissible fade show" role="alert">
					{{ message }}
					<button type="button" class="close" data-dismiss="alert" aria-label="Close">
						<span aria-hidden="true">&times;</span>
					</button>
				</div>
			{% endfor %}
		{% endfor %}

		{% if app.session.get('user_email') or app.request.get('_route') in ['login', 'app_signin'] %}
			{% block content %}
				<!-- Navbar -->
				{% block navbar %}
					<div id="pcoded" class="pcoded">
						<div class="pcoded-overlay-box"></div>
						<div class="pcoded-container navbar-wrapper">
							<nav class="navbar header-navbar pcoded-header">
								<div class="navbar-wrapper">
									<div class="navbar-logo">
										<a class="mobile-menu" id="mobile-collapse" href="#!">
											<i class="ti-menu"></i>
										</a>
										<a href="{{ path('admin_dashboard') }}">
											<img class="img-fluid" src="{{ asset('back/images/logo.png') }}" alt="Theme-Logo"/>
										</a>
										<a class="mobile-options">
											<i class="ti-more"></i>
										</a>
									</div>

									<div class="navbar-container container-fluid">
										<ul class="nav-left">
											<li>
												<div class="sidebar_toggle">
													<a href="javascript:void(0)">
														<i class="ti-menu"></i>
													</a>
												</div>
											</li>
										</ul>
										<ul class="nav-right">
											{% if app.session.get('user_email') %}
												<li class="user-profile header-notification">
													<a href="#!">
														<img src="data:image/jpeg;base64,{{ user.photo }}" class="img-radius" alt="User-Profile-Image">
														<span>{{ user.nom }}
															{{ user.prenom }}</span>
														<i class="ti-angle-down"></i>
													</a>
													<ul class="show-notification profile-notification">
														<li>
															<a href="{{ path('user_profile') }}">
																<i class="ti-user"></i>
																Profile
															</a>
														</li>
														<li>
															<a href="{{ path('logout') }}">
																<i class="ti-layout-sidebar-left"></i>
																Logout
															</a>
														</li>
													</ul>
												</li>
											{% endif %}
										</ul>
									</div>
								</div>
							</nav>
						</div>
					</div>
				{% endblock %}

				{% block main %}
					<div class="pcoded-main-container">
						<div
							class="pcoded-wrapper">
							<!-- Sidebar -->
							{% block sidebar %}

								{% if app.session.get('user_email') %}
									<nav class="pcoded-navbar">
										<div class="sidebar_toggle">
											<a href="#">
												<i class="icon-close icons"></i>
											</a>
										</div>
										<div class="pcoded-inner-navbar main-menu">
											<div class="">
												<div class="main-menu-header">
													<img class="img-40 img-radius" src="{{ asset('back/images/avatar-4.jpg') }}" alt="User-Profile-Image">
													<div class="user-details">
														<span>{{ user.nom }}
															{{ user.prenom }}</span>
														<span id="more-details">{{ user.role }}<i class="ti-angle-down"></i>
														</span>
													</div>
												</div>
											</div>

											<ul class="pcoded-item pcoded-left-item">
												<li class="active">
													<a href="{{ path('admin_dashboard') }}">
														<span class="pcoded-micon">
															<i class="ti-home"></i>
															<b>D</b>
														</span>
														<span class="pcoded-mtext">Dashboard</span>
														<span class="pcoded-mcaret"></span>
													</a>
												</li>
												{% if user.role == 'ROLE_ADMIN' %}
													<li class="pcoded-hasmenu">
														<a href="javascript:void(0)">
															<span class="pcoded-micon">
																<i class="ti-layout-grid2-alt"></i>
															</span>
															<span class="pcoded-mtext">Management</span>
															<span class="pcoded-mcaret"></span>
														</a>
														<ul class="pcoded-submenu">
															<li>
																<a href="{{ path('app_user_index') }}">
																	<span class="pcoded-micon">
																		<i class="ti-angle-right"></i>
																	</span>
																	<span class="pcoded-mtext">Utilisateurs</span>
																</a>
															</li>
															{# Commentez ou supprimez les routes non définies
															                            <li>
															                                <a href="{{ path('classes') }}">
															                                    <span class="pcoded-micon"><i class="ti-angle-right"></i></span>
															                                    <span class="pcoded-mtext">Classes</span>
															                                </a>
															                            </li>
															                            <li>
															                                <a href="{{ path('discussions') }}">
															                                    <span class="pcoded-micon"><i class="ti-angle-right"></i></span>
															                                    <span class="pcoded-mtext">Discussions</span>
															                                </a>
															                            </li>
															                            <li>
															                                <a href="{{ path('publication') }}">
															                                    <span class="pcoded-micon"><i class="ti-angle-right"></i></span>
															                                    <span class="pcoded-mtext">Publications</span>
															                                </a>
															                            </li>
															                            <li>
															                                <a href="{{ path('club') }}">
															                                    <span class="pcoded-micon"><i class="ti-angle-right"></i></span>
															                                    <span class="pcoded-mtext">Club</span>
															                                </a>
															                            </li>
															                            <li>
															                                <a href="{{ path('planning') }}">
															                                    <span class="pcoded-micon"><i class="ti-angle-right"></i></span>
															                                    <span class="pcoded-mtext">Planning</span>
															                                </a>
															                            </li>
															                            #}
														</ul>
													</li>
												{% endif %}
											</ul>
										</div>
									</nav>
								{% endif %}
							{% endblock %}

							<div class="pcoded-content">
								<div class="pcoded-inner-content">
									<div class="main-body">
										<div class="page-wrapper">
											{% block welc %}
												{% if app.session.get('user_email') %}
													<div class="page-body">
														<h1>Welcome
															{{ user.nom }}
															{{ user.prenom }}</h1>
													</div>
												{% endif %}
											{% endblock %}
										</div>
									</div>
								</div>
							</div>
						</div>
					</div>
				{% endblock %}
			{% endblock %}
		{% else %}
			<div class="alert alert-warning text-center">
				<h4>Accès restreint</h4>
				<p>Veuillez vous
					<a href="{{ path('login') }}">connecter</a>
					pour accéder au dashboard.</p>
			</div>
		{% endif %}

		{% block js %}
			<script type="text/javascript" src="{{ asset('back/js/jquery/jquery.min.js') }}"></script>
			<script type="text/javascript" src="{{ asset('back/js/jquery-ui/jquery-ui.min.js') }}"></script>
			<script type="text/javascript" src="{{ asset('back/js/popper.js/popper.min.js') }}"></script>
			<script type="text/javascript" src="{{ asset('back/js/bootstrap/js/bootstrap.min.js') }}"></script>
			<script type="text/javascript" src="{{ asset('back/js/jquery-slimscroll/jquery.slimscroll.js') }}"></script>
			<script type="text/javascript" src="{{ asset('back/js/modernizr/modernizr.js') }}"></script>
			<script type="text/javascript" src="{{ asset('back/js/script.js') }}"></script>
			<script type="text/javascript" src="{{ asset('back/js/SmoothScroll.js') }}"></script>
			<script src="{{ asset('back/js/pcoded.min.js') }}"></script>
			<script src="{{ asset('back/js/demo-12.js') }}"></script>
			<script src="{{ asset('back/js/jquery.mCustomScrollbar.concat.min.js') }}"></script>
		{% endblock %}

	</body>
</html>

{% extends 'base_back.html.twig' %}

{% block title %}Discussion Details{% endblock %}

{% block content %}

    <div class="card-body" style=" margin: 5px; ">
        <h1 class="text-center" style="display: inline-block; white-space: nowrap; width: auto; margin: 10px; padding: 10px 15px; font-size: 26px;">Détails de la Discussion</h1>

        <table class="table table-bordered" style="border-radius: 10px; overflow: hidden;">
            <tbody>
                <tr>
                    <th style="background-color: #f8f9fa; width: 200px; text-align: left;">ID</th>
                    <td>{{ discussion.id }}</td>
                </tr>
                <tr>
                    <th style="background-color: #f8f9fa; text-align: left;">Adresse</th>
                    <td>{{ discussion.adresse }}</td>
                </tr>
                <tr>
                    <th style="background-color: #f8f9fa; text-align: left;">Sujet</th>
                    <td>{{ discussion.sujet }}</td>
                </tr>
                <tr>
                    <th style="background-color: #f8f9fa; text-align: left;">Destinataire</th>
                    <td>{{ discussion.destinataire }}</td>
                </tr>
                <tr>
                    <th style="background-color: #f8f9fa; text-align: left;">Contenu</th>
                    <td>{{ discussion.contenu }}</td>
                </tr>
                <tr>
                    <th style="background-color: #f8f9fa; text-align: left;">Professeur</th>
                    <td>{{ discussion.professeur }}</td>
                </tr>
                <tr>
                    <th style="background-color: #f8f9fa; text-align: left;">Rôle</th>
                    <td>{{ discussion.role }}</td>
                </tr>
                <tr>
                    <th style="background-color: #f8f9fa; text-align: left;">Élève</th>
                    <td>{{ discussion.eleve }}</td>
                </tr>

            </tbody>
        </table>

       <div class="d-flex justify-content-start mt-3">
    <a href="{{ path('app_discussion_index') }}" class="btn btn-secondary me-2">Retour </a>
    <a href="{{ path('app_discussion_edit', {'id': discussion.id}) }}" class="btn btn-warning me-2">Modifier</a>

    <form method="post" action="{{ path('app_discussion_delete', {'id': discussion.id}) }}" onsubmit="return confirm('Are you sure?');">
        <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ discussion.id) }}">
        <button type="submit" class="btn btn-danger">Supprimer</button>
    </form>
</div>

    </div>

{% endblock %}

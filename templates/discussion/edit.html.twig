{% extends 'base_back.html.twig' %}

{% block title %}Modifier la discussion{% endblock %}

{% block welc %}{% endblock %}
{% block preloader %}{% endblock %}
{% block main %}{% endblock %}


{% block content %}
   <div class="container d-flex justify-content-center align-items-center" style="min-height: 100vh; margin: 30px; margin-top: 200px">
       <div class="card shadow-lg p-4 w-50" style="background: #fff; border-radius: 10px;">
            <h2 class="text-center text-primary mb-4">Modifier la Discussion</h2>
            
            {{ form_start(form) }}

            <div class="form-container">
                {{ form_widget(form) }}
            </div>

            <div class="d-flex justify-content-between mt-4">
                <a href="{{ path('app_discussion_index') }}" class="btn btn-secondary">Retour</a>

                <div>
                    <button type="submit" class="btn btn-primary">Enregistrer</button>
                </div>
            </div>

            {{ form_end(form) }}

            <div class="text-center mt-3">
                <form method="post" action="{{ path('app_discussion_delete', {'id': discussion.id}) }}" onsubmit="return confirm('Voulez-vous vraiment supprimer cette discussion ?');">
                    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ discussion.id) }}">
                    <button type="submit" class="btn btn-danger">Supprimer</button>
                </form>
            </div>
       </div>
   </div>
{% endblock %}
